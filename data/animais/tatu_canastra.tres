[gd_resource type="Resource" script_class="EspecieAnimal" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Nucleo/EspecieAnimal.cs" id="1"]

[resource]
script = ExtResource("1")
Nome = "Tatu-canastra"
NomeCientifico = "Priodontes maximus (Kerr, 1792)"
Ficha = "[b]Identificação[/b]\nÉ o maior tatu do mundo: pode passar de 1,5 m de comprimento total e pesar cerca de 50 kg. Tem carapaça escura, cabeça alongada e garras dianteiras enormes, usadas para cavar.\n\n[b]Ambiente[/b]\nVive em áreas de Cerrado, Amazônia, Pantanal e Mata Atlântica, em locais com solo arenoso e boa oferta de formigas e cupins. É difícil de observar porque passa boa parte do tempo em tocas.\n\n[b]Alimentação[/b]\nAlimenta-se principalmente de formigas e cupins, que encontra ao escavar o solo. Também pode comer outros invertebrados e material vegetal em pequena quantidade.\n\n[b]Conservação[/b]\nEstá classificado como [b]Vulnerável (VU)[/b] no Brasil e globalmente. A caça, a perda de habitat, os atropelamentos e as queimadas são as principais ameaças.\n\n[b]Curiosidade[/b]\nÉ considerado um \"engenheiro do ecossistema\": suas tocas grandes são usadas por outros animais, como jaguatiricas, raposas e até tatus menores."
Fontes = "ICMBio — Ficha de Priodontes maximus: https://www.gov.br/icmbio/pt-br/assuntos/centros-de-pesquisa/primatas-brasileiros/arquivos/fichas_xenathra/cingulata/ficha_priodontes_maximus.pdf\nInstituto de Conservação de Animais Silvestres (ICAS) — Tatu-canastra: https://www.icasconservation.org.br/projetos/tatucanastra/"
SpritePath = "res://assets/art/tatu_canastra.png"
Cor = Color(0.45, 0.32, 0.20, 1)
